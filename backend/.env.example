PORT=5020
MONGO_URI=mongodb://127.0.0.1:27017/comptool
CORS_ORIGIN=http://localhost:3020
NODE_ENV=development

# Org directory (server-side - never put this key in VITE_* frontend env)
ORG_API_URL=
ORG_API_KEY=

# Employee codes / emails that get the admin dashboard
ADMIN_EMPLOYEE_CODES=
ADMIN_EMAILS=

# Signs employee-code sessions when AUTH_DISABLED=false
SESSION_SECRET=

# Behind nginx / IIS / Azure: TRUST_PROXY=true and REQUIRE_HTTPS=true
TRUST_PROXY=false
REQUIRE_HTTPS=false

# Microsoft SSO - optional until MSAL is wired on the frontend
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_ALLOWED_EMAIL_DOMAINS=

# Local demo impersonation only. Must be false / unset for launch.
AUTH_DISABLED=true
