PORT=5020
MONGO_URI=mongodb://127.0.0.1:27017/comptool
CORS_ORIGIN=http://localhost:3020
NODE_ENV=development

# Org directory (backend only)
ORG_API_URL=
ORG_API_KEY=

# Who sees the admin dashboard (comma separated). Everyone else can sign in normally.
ADMIN_EMAILS=
ADMIN_EMPLOYEE_CODES=

# Microsoft SSO (any account in the tenant can sign in)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

SESSION_SECRET=
AUTH_DISABLED=true

# Production behind a proxy
TRUST_PROXY=false
REQUIRE_HTTPS=false
