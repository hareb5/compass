# Copy to .env for local bun run dev. For production builds, copy the VITE_MSAL_*
# values into .env.production.local (gitignored), then npm run build.
#
# Vite only exposes VITE_* to the browser. AZURE_CLIENT_ID / AZURE_TENANT_ID are
# backend-only and will not configure Microsoft login here.
# TanStack Start also injects VITE_MSAL_* at build time (see vite.config.ts).

VITE_USE_API=false
VITE_SHOW_DEMO=true
VITE_APP_URL=http://localhost:3020

# Microsoft SSO - same names as talent/hpa-frontend
# Azure Portal -> App registrations -> Authentication:
# Platform must be Single-page application (SPA), not Web (fixes AADSTS9002326).
# Add this origin as a SPA redirect URI (localhost:3020 for local, production URL for launch).
# Set VITE_USE_API=true for SSO / API sign-in.
VITE_MSAL_CLIENT_ID=your-azure-app-client-id
VITE_MSAL_TENANT_ID=your-azure-tenant-id
VITE_MSAL_REDIRECT_URI=http://localhost:3020

# Vite-dev proxy only (not bundled). For production put these on the backend.
ORG_API_URL=
ORG_API_KEY=
